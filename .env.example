# Database
DATABASE_URL="postgresql://customs_user:customs_pass@localhost:5432/customs_db"
DB_USER=customs_user
DB_PASSWORD=customs_pass
DB_NAME=customs_db

# JWT
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# AI chatbox (mặc định Ollama local - miễn phí, không cần key)
# Đổi sang Groq/Gemini/OpenAI bằng cách sửa 3 biến này. Xem backend/.env để biết mẫu.
AI_BASE_URL=http://host.docker.internal:11434/v1
AI_MODEL=qwen2.5:3b
AI_API_KEY=not-needed

# Đọc ảnh chụp tờ khai giấy (mục "Nhập từ file"). Đây là mô hình THỊ GIÁC, phải
# pull riêng: ollama pull qwen2.5vl:7b
AI_VISION_MODEL=qwen2.5vl:7b
# Muốn đọc ảnh chạy ở dịch vụ khác mà vẫn giữ chatbox chạy cục bộ thì đặt thêm:
# AI_VISION_BASE_URL=https://api.openai.com/v1
# AI_VISION_API_KEY=<khoá của bạn>
# AI_VISION_API_STYLE=openai      # 'ollama' hoặc 'openai'; để trống thì tự nhận diện
# AI_VISION_NUM_CTX=8192          # cửa sổ ngữ cảnh khi đọc ảnh (chỉ dùng cho Ollama)

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000
